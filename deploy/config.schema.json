{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htp.invalid/schemas/deploy-config.schema.json",
  "title": "HTP deployment configuration",
  "description": "Fail-closed LOCAL_TEST input or non-deployable chain placeholder. It never represents production approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "configVersion",
    "deploymentVersion",
    "expectedFirstCreateNonce",
    "mode",
    "usage",
    "environment",
    "network",
    "securityLimits",
    "roles",
    "deploymentInputs",
    "externalPolicy"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "(^|/)config\\.schema\\.json$"
    },
    "configVersion": {
      "$ref": "#/$defs/numericSemVer"
    },
    "deploymentVersion": {
      "$ref": "#/$defs/numericSemVer"
    },
    "expectedFirstCreateNonce": {
      "$ref": "#/$defs/nonNegativeSafeIntegerOrNull"
    },
    "mode": {
      "enum": [
        "LOCAL_TEST",
        "CHAIN_PLACEHOLDER"
      ]
    },
    "usage": {
      "enum": [
        "LOCAL_ONLY",
        "NOT_DEPLOYABLE"
      ]
    },
    "environment": {
      "enum": [
        "LOCAL",
        "TESTNET",
        "PLACEHOLDER"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "chainId"
      ],
      "properties": {
        "name": {
          "enum": [
            "LOCAL",
            "Ethereum",
            "BSC",
            "HSK"
          ]
        },
        "chainId": {
          "$ref": "#/$defs/positiveIntegerOrNull"
        }
      }
    },
    "securityLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterProviderCallGasMax",
        "calculatorStaticcallGas",
        "registryImplementationStaticcallGas",
        "registryReadStaticcallGas",
        "tokenViewStaticcallGas",
        "tokenWriteCallGas",
        "eip1271MaxChecksPerSettlement",
        "eip1271GasPolicy",
        "maxDependentDvps"
      ],
      "properties": {
        "adapterProviderCallGasMax": {
          "const": 100000
        },
        "calculatorStaticcallGas": {
          "const": 100000
        },
        "registryImplementationStaticcallGas": {
          "const": 200000
        },
        "registryReadStaticcallGas": {
          "const": 300000
        },
        "tokenViewStaticcallGas": {
          "const": 30000
        },
        "tokenWriteCallGas": {
          "const": 100000
        },
        "eip1271MaxChecksPerSettlement": {
          "const": 2
        },
        "eip1271GasPolicy": {
          "const": "FORWARD_REMAINING_GAS_EIP150"
        },
        "maxDependentDvps": {
          "const": 32
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployer",
        "defaultAdmin",
        "governance",
        "upgrader",
        "pauser",
        "executor",
        "configurer"
      ],
      "properties": {
        "deployer": {
          "$ref": "#/$defs/addressOrNull"
        },
        "defaultAdmin": {
          "$ref": "#/$defs/addressOrNull"
        },
        "governance": {
          "$ref": "#/$defs/addressOrNull"
        },
        "upgrader": {
          "$ref": "#/$defs/addressOrNull"
        },
        "pauser": {
          "$ref": "#/$defs/addressOrNull"
        },
        "executor": {
          "$ref": "#/$defs/addressOrNull"
        },
        "configurer": {
          "$ref": "#/$defs/addressOrNull"
        }
      }
    },
    "deploymentInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "providers",
        "participants",
        "collector",
        "economicAssetIdHash",
        "schedule",
        "fee",
        "marketRule",
        "evidenceHash"
      ],
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetToken",
            "assetDecimals",
            "settlementToken",
            "settlementTokenDecimals",
            "erc1404Token",
            "usdyToken"
          ],
          "properties": {
            "assetToken": {
              "$ref": "#/$defs/addressOrNull"
            },
            "assetDecimals": {
              "$ref": "#/$defs/decimalsOrNull"
            },
            "settlementToken": {
              "$ref": "#/$defs/addressOrNull"
            },
            "settlementTokenDecimals": {
              "$ref": "#/$defs/decimalsOrNull"
            },
            "erc1404Token": {
              "$ref": "#/$defs/addressOrNull"
            },
            "usdyToken": {
              "$ref": "#/$defs/addressOrNull"
            }
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usdyBlocklist",
            "usdyAllowlist",
            "usdySanctionsList",
            "providerCallGas"
          ],
          "properties": {
            "usdyBlocklist": {
              "$ref": "#/$defs/addressOrNull"
            },
            "usdyAllowlist": {
              "$ref": "#/$defs/addressOrNull"
            },
            "usdySanctionsList": {
              "$ref": "#/$defs/addressOrNull"
            },
            "providerCallGas": {
              "$ref": "#/$defs/positiveIntegerOrNull"
            }
          }
        },
        "participants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maker",
            "requester"
          ],
          "properties": {
            "maker": {
              "$ref": "#/$defs/addressOrNull"
            },
            "requester": {
              "$ref": "#/$defs/addressOrNull"
            }
          }
        },
        "collector": {
          "$ref": "#/$defs/addressOrNull"
        },
        "economicAssetIdHash": {
          "$ref": "#/$defs/bytes32OrNull"
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quoteValidFrom",
            "quoteValidUntil",
            "settlementValidUntil"
          ],
          "properties": {
            "quoteValidFrom": {
              "$ref": "#/$defs/positiveIntegerOrNull"
            },
            "quoteValidUntil": {
              "$ref": "#/$defs/positiveIntegerOrNull"
            },
            "settlementValidUntil": {
              "$ref": "#/$defs/positiveIntegerOrNull"
            }
          }
        },
        "fee": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "investorRateBps",
            "investorHasCap",
            "investorCapAmount",
            "makerRateBps",
            "makerHasCap",
            "makerCapAmount"
          ],
          "properties": {
            "investorRateBps": {
              "$ref": "#/$defs/basisPointsOrNull"
            },
            "investorHasCap": {
              "$ref": "#/$defs/booleanOrNull"
            },
            "investorCapAmount": {
              "$ref": "#/$defs/nonNegativeSafeIntegerOrNull"
            },
            "makerRateBps": {
              "$ref": "#/$defs/basisPointsOrNull"
            },
            "makerHasCap": {
              "$ref": "#/$defs/booleanOrNull"
            },
            "makerCapAmount": {
              "$ref": "#/$defs/nonNegativeSafeIntegerOrNull"
            }
          }
        },
        "marketRule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minCashPrincipal",
            "minExecutableQuantity",
            "quantityStep",
            "priceTick",
            "priceDecimals",
            "quantityDecimals"
          ],
          "properties": {
            "minCashPrincipal": {
              "$ref": "#/$defs/positiveIntegerOrNull"
            },
            "minExecutableQuantity": {
              "$ref": "#/$defs/positiveIntegerOrNull"
            },
            "quantityStep": {
              "$ref": "#/$defs/positiveIntegerOrNull"
            },
            "priceTick": {
              "$ref": "#/$defs/positiveIntegerOrNull"
            },
            "priceDecimals": {
              "$ref": "#/$defs/decimalsOrNull"
            },
            "quantityDecimals": {
              "$ref": "#/$defs/decimalsOrNull"
            }
          }
        },
        "evidenceHash": {
          "$ref": "#/$defs/bytes32OrNull"
        }
      }
    },
    "externalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalStatus",
        "rpcUrls",
        "finalityConfirmations",
        "gasPolicy",
        "transactionType"
      ],
      "properties": {
        "approvalStatus": {
          "enum": [
            "LOCAL_ONLY",
            "UNAPPROVED"
          ]
        },
        "rpcUrls": {
          "type": "null"
        },
        "finalityConfirmations": {
          "type": "null"
        },
        "gasPolicy": {
          "type": "null"
        },
        "transactionType": {
          "type": "null"
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "Executable local or offline test fixture",
      "properties": {
        "mode": {
