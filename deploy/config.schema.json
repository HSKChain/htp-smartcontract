        "deploymentInputs": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "object",
              "properties": {
                "assetToken": {
                  "$ref": "#/$defs/nonZeroAddress"
                },
                "assetDecimals": {
                  "$ref": "#/$defs/decimals"
                },
                "settlementToken": {
                  "$ref": "#/$defs/nonZeroAddress"
                },
                "settlementTokenDecimals": {
                  "$ref": "#/$defs/decimals"
                },
                "erc1404Token": {
                  "$ref": "#/$defs/nonZeroAddress"
                },
                "usdyToken": {
                  "$ref": "#/$defs/nonZeroAddress"
                }
              }
            },
            "providers": {
              "type": "object",
              "properties": {
                "usdyBlocklist": {
                  "$ref": "#/$defs/nonZeroAddress"
                },
                "usdyAllowlist": {
                  "$ref": "#/$defs/nonZeroAddress"
                },
                "usdySanctionsList": {
                  "$ref": "#/$defs/nonZeroAddress"
                },
                "providerCallGas": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/positiveInteger"
                    },
                    {
                      "type": "integer",
                      "maximum": 100000
                    }
                  ]
                }
              }
            },
            "participants": {
              "type": "object",
              "properties": {
                "maker": {
                  "$ref": "#/$defs/nonZeroAddress"
                },
                "requester": {
                  "$ref": "#/$defs/nonZeroAddress"
                }
              }
            },
            "collector": {
              "$ref": "#/$defs/nonZeroAddress"
            },
            "economicAssetIdHash": {
              "$ref": "#/$defs/nonZeroBytes32"
            },
            "schedule": {
              "type": "object",
              "properties": {
                "quoteValidFrom": {
                  "$ref": "#/$defs/positiveInteger"
                },
                "quoteValidUntil": {
                  "$ref": "#/$defs/positiveInteger"
                },
                "settlementValidUntil": {
                  "$ref": "#/$defs/positiveInteger"
                }
              }
            },
            "fee": {
              "type": "object",
              "properties": {
                "investorRateBps": {
                  "$ref": "#/$defs/basisPoints"
                },
                "investorHasCap": {
                  "type": "boolean"
                },
                "investorCapAmount": {
                  "$ref": "#/$defs/nonNegativeSafeInteger"
                },
                "makerRateBps": {
                  "$ref": "#/$defs/basisPoints"
                },
                "makerHasCap": {
                  "type": "boolean"
                },
                "makerCapAmount": {
                  "$ref": "#/$defs/nonNegativeSafeInteger"
                }
              }
            },
            "marketRule": {
              "type": "object",
              "properties": {
                "minCashPrincipal": {
                  "$ref": "#/$defs/positiveInteger"
                },
                "minExecutableQuantity": {
                  "$ref": "#/$defs/positiveInteger"
                },
                "quantityStep": {
                  "$ref": "#/$defs/positiveInteger"
                },
                "priceTick": {
                  "$ref": "#/$defs/positiveInteger"
                },
                "priceDecimals": {
                  "$ref": "#/$defs/decimals"
                },
                "quantityDecimals": {
                  "$ref": "#/$defs/decimals"
                }
              }
            },
            "evidenceHash": {
              "$ref": "#/$defs/nonZeroBytes32"
            }
          }
        },
        "externalPolicy": {
          "type": "object",
          "properties": {
            "approvalStatus": {
              "const": "LOCAL_ONLY"
            }
          }
        }
      }
    },
    {
      "title": "Non-deployable chain placeholder",
      "properties": {
        "mode": {
          "const": "CHAIN_PLACEHOLDER"
        },
        "usage": {
          "const": "NOT_DEPLOYABLE"
        },
        "environment": {
          "const": "PLACEHOLDER"
        },
        "expectedFirstCreateNonce": {
          "type": "null"
        },
        "network": {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "Ethereum",
                "BSC",
                "HSK"
              ]
            },
            "chainId": {
              "type": "null"
