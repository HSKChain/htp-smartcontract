  "$defs": {
    "numericSemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "description": "JSON-safe subset of uint64; larger integers cannot be represented without precision loss.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeIntegerOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "basisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "basisPointsOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/basisPoints"
        },
        {
          "type": "null"
        }
      ]
    },
    "booleanOrNull": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "positiveIntegerOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/positiveInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "decimals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 36
    },
    "decimalsOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/decimals"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonZeroAddress": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "addressOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonZeroAddress"
        },
        {
          "type": "null"
        }
      ]
    },
    "addressIncludingZeroOrNull": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonZeroBytes32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
    },
    "bytes32OrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonZeroBytes32"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
