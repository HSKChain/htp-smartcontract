{
  // ===========================================================================
  // HTP 部署配置逐字段说明
  // ===========================================================================
  //
  // 重要：
  // 1. 这是 JSONC 阅读模板，允许 // 注释，但不能直接传给 Foundry。
  // 2. 真正部署必须把选定值复制到严格 JSON，例如 deploy/config.example.json。
  // 3. LOCAL_TEST 的所有地址都必须是非零的 0x + 40 个十六进制字符。
  // 4. 仓库禁止保存私钥、助记词、签名、KMS 标识、RPC 凭证、客户 PII 或 raw transaction。
  // 5. 当前 Schema 只支持 LOCAL_TEST 和不可部署的 CHAIN_PLACEHOLDER，不代表生产批准。
  //
  // 模式组合：
  // - 可执行本地配置：
  //   mode=LOCAL_TEST
  //   usage=LOCAL_ONLY
  //   environment=LOCAL 或 TESTNET
  //   network.name=LOCAL
  //   externalPolicy.approvalStatus=LOCAL_ONLY
  //
  // - 不可部署链占位：
  //   mode=CHAIN_PLACEHOLDER
  //   usage=NOT_DEPLOYABLE
  //   environment=PLACEHOLDER
  //   network.name=Ethereum/BSC/HSK
  //   地址、chainId、外部策略全部为 null/UNAPPROVED
  //

  // ---------------------------------------------------------------------------
  // Schema 定位
  // ---------------------------------------------------------------------------
  // 可填写：以 config.schema.json 结尾的相对路径。
  // 推荐：与本文件同目录时填写 "./config.schema.json"。
  // 作用：IDE 可据此提示字段；Node 校验器会使用仓库固定 Schema。
  // 不可填写：http RPC、任意远程 Schema、.env 路径。
  "$schema": "./config.schema.json",

  // ---------------------------------------------------------------------------
  // 配置格式版本
  // ---------------------------------------------------------------------------
  // 格式：纯数字 MAJOR.MINOR.PATCH。
  // 合法：0.0.0、1.0.0、12.34.56。
  // 非法：v1.0.0、01.0.0、1.0、1.0.0-beta、1.0.0+build。
  // 作用：表示本 JSON 配置结构的版本，与 DvP 合约版本无关。
  "configVersion": "1.0.0",

  // ---------------------------------------------------------------------------
  // DvP 部署版本
  // ---------------------------------------------------------------------------
  // 格式规则与 configVersion 相同，必须是 canonical numeric SemVer。
  // 作用：
  // - 计算 deploymentVersionHash；
  // - EIP-712 Domain.version 使用 MAJOR 部分；
  // - AssetVersionConfig 会绑定 deploymentVersionHash；
  // - 更换 MAJOR 或 DvP 地址后旧签名不能迁移。
  // 本地示例可用 0.0.0；正式测试版本建议按发布计划填写，例如 1.0.0。
  "deploymentVersion": "0.0.0",

  // ---------------------------------------------------------------------------
  // 部署 EOA 起始 nonce
  // ---------------------------------------------------------------------------
  // 类型：0 到 Number.MAX_SAFE_INTEGER 的整数。
  // 获取示例：
  // cast nonce <DEPLOYER_ADDRESS> --rpc-url <RPC>
  // 作用：
  // - 预测 8 个 Registry implementation/proxy、ValidatorFactory 和 DvP 地址；
  // - 当前 core 部署共消耗 18 个 CREATE nonce；
  // - 第一个合约使用此 nonce，DvP 使用 nonce+17，结束后账户 nonce 应为 nonce+18。
  // 安全要求：广播前再次读取链上 nonce；不一致时零部署、零广播并立即失败。
  "expectedFirstCreateNonce": 0,

  // ---------------------------------------------------------------------------
  // 配置模式
  // ---------------------------------------------------------------------------
  // 可填写：
  // - LOCAL_TEST：可执行本地/离线/受控测试网部署。
  // - CHAIN_PLACEHOLDER：只记录未来链配置结构，永远不可部署。
  // 当前可执行示例必须填写 LOCAL_TEST。
  "mode": "LOCAL_TEST",

  // ---------------------------------------------------------------------------
  // 使用范围
  // ---------------------------------------------------------------------------
  // 可填写：
  // - LOCAL_ONLY：仅本地或受控测试，不是生产批准。
  // - NOT_DEPLOYABLE：占位文件。
  // LOCAL_TEST 只能搭配 LOCAL_ONLY。
  "usage": "LOCAL_ONLY",

  // ---------------------------------------------------------------------------
  // 环境类型
  // ---------------------------------------------------------------------------
  // 可填写：
  // - LOCAL：Anvil、本地 EVM。
  // - TESTNET：受控测试网；当前仍属于 LOCAL_ONLY，不代表生产。
  // - PLACEHOLDER：三链占位模板专用。
  // LOCAL_TEST 可填写 LOCAL 或 TESTNET；CHAIN_PLACEHOLDER 必须填写 PLACEHOLDER。
  "environment": "LOCAL",

  "network": {
    // -------------------------------------------------------------------------
    // 网络逻辑名称
    // -------------------------------------------------------------------------
    // 可填写：LOCAL、Ethereum、BSC、HSK。
    // 当前 Schema 中可执行 LOCAL_TEST 使用 LOCAL。
    // Ethereum/BSC/HSK 仅用于 chains/*.placeholder.json，未批准前不可部署。
    "name": "LOCAL",

    // -------------------------------------------------------------------------
    // EVM chainId
    // -------------------------------------------------------------------------
    // 类型：1 到 Number.MAX_SAFE_INTEGER 的整数。
    // 常见本地值：Anvil 默认 31337。
    // 必须等于部署时 block.chainid，否则 DvP constructor 会失败。
    // 不要凭记忆为未批准链填写 chainId；占位模板必须为 null。
    "chainId": 31337
  },

  // ---------------------------------------------------------------------------
  // Phase 19 冻结的合约安全/Gas 上限
  // ---------------------------------------------------------------------------
  // 这些值来自生产编译配置下的 operation-only Gas 基准，不是逐链 Gas
  // price/交易费用策略。所有严格 JSON manifest 必须逐项包含并精确匹配。
  // providerCallGas 可低于 adapterProviderCallGasMax，但不得超过 100000。
  // EIP-1271 每笔最多检查报价方和询价方两个钱包；不使用破坏兼容性的低
  // 固定 stipend，而按 EIP-150 转发调用点剩余 Gas。
  "securityLimits": {
    "adapterProviderCallGasMax": 100000,
    "calculatorStaticcallGas": 100000,
    "registryImplementationStaticcallGas": 200000,
    "registryReadStaticcallGas": 300000,
    "tokenViewStaticcallGas": 30000,
    "tokenWriteCallGas": 100000,
    "eip1271MaxChecksPerSettlement": 2,
    "eip1271GasPolicy": "FORWARD_REMAINING_GAS_EIP150",
    "maxDependentDvps": 32
  },

  "roles": {
    // =========================================================================
    // 直接角色模型
    // =========================================================================
    // 每个字段必须完整填写合法非零地址。地址可以重复；同一个地址可以持有
    // default admin、governance、upgrader、pauser、executor 和全部操作角色。

    // -------------------------------------------------------------------------
    // 部署 EOA
    // -------------------------------------------------------------------------
    // 必须等于 Foundry 实际 signer/sender。
    // 可以与任意角色地址相同。
    // 禁止在配置中填写该地址的私钥。
    "deployer": "0x0000000000000000000000000000000000001001",

    // Registry 与 DvP 的 default admin，可与 governance/upgrader 等角色相同。
    "defaultAdmin": "0x0000000000000000000000000000000000001002",

    // Registry 与 DvP 的治理执行地址。
    "governance": "0x0000000000000000000000000000000000001002",

    // Registry 的 UUPS 升级地址；DvP 不授予该角色。
    "upgrader": "0x0000000000000000000000000000000000001002",

    // -------------------------------------------------------------------------
    // 紧急暂停角色
    // -------------------------------------------------------------------------
    // 可以调用 DvP.pauseGlobal 和各 Registry 的类型化 pause。
    // 不能恢复、激活、弃用、升级或执行 settle。
    // 可与其它角色地址相同。
    "pauser": "0x0000000000000000000000000000000000001003",

    // -------------------------------------------------------------------------
    // DvP Executor
    // -------------------------------------------------------------------------
    // 调用 DvP.settle 的交易发送方，不替代 Maker/Requester 双签。
    // 可与其它角色地址相同。
    "executor": "0x0000000000000000000000000000000000001004",

    // -------------------------------------------------------------------------
    // Configurer（八个 Registry 共用的唯一运营配置角色）
    // -------------------------------------------------------------------------
    // 覆盖范围：
    //   - 六类配置登记：Adapter、Principal Calculator、Settlement Token、
    //     Asset Version、Market Rule、Fee Version
    //   - 两类即时写入：Participant 身份、Eligibility 资格
    //
    // 不能做的事：activate / seal / unpause / deprecate / close 一律属于 governance；
    // pause 属于 pauser；升级属于 upgrader；settle 属于 executor。
    //
    // 安全提示：六类配置登记后仍需 governance 激活才生效，但 Participant 与
    // Eligibility 是单段式，写入即刻生效。因此本角色是唯一能不经治理批准
    // 直接放行交易主体的路径，密钥等级应按此对待，生产环境建议使用多签。
    //
    // 可与其它角色地址相同，但生产环境建议与 executor、governance 分离。
    "configurer": "0x0000000000000000000000000000000000001005"
  },

  "deploymentInputs": {
    // =========================================================================
    // 业务配置图输入
    // =========================================================================
    // 注意：core deploy 只部署七 Registry、ValidatorFactory 和 DvP。
    // 下列输入用于后续部署/注册 Calculator、Adapter、Token、AssetVersion、
    // Participant、Eligibility 和 Fee 配置图。
    // 如果只试跑 core deploy，示例非零地址可通过结构校验，但不能完成配置激活；
    // 完整配置图要求这些地址在目标链上确实有符合 ABI 的代码。

    "tokens": {
      // -----------------------------------------------------------------------
      // 主资产 Token
      // -----------------------------------------------------------------------
      // 填写本次 DvP 交割的 ERC-20/ERC-1404/Fund Token 地址。
      // 必须非零、有 runtime code，并且 decimals() 返回规范 32-byte ABI。
      // 不能与 settlementToken 相同。
      "assetToken": "0x0000000000000000000000000000000000002001",

      // Asset Token decimals，整数范围 0–36。
      // 必须与 assetToken.decimals() 完全一致。
      // 常见值：18；不得为了显示方便自行缩放。
      "assetDecimals": 18,

      // -----------------------------------------------------------------------
      // Settlement Token
      // -----------------------------------------------------------------------
      // 支付 Cash Principal、buyerFee、sellerFee 的 Token 地址。
      // 一笔结算中的本金与费用只能使用该同一种 Token。
      // 必须非零、有 code，并在 SettlementTokenRegistry 中注册/激活。
      "settlementToken": "0x0000000000000000000000000000000000002002",

      // Settlement Token decimals，整数范围 0–36。
      // 必须与 settlementToken.decimals() 完全一致。
      // 常见稳定币可能是 6，但必须以目标 Token 链上返回为准。
      "settlementTokenDecimals": 6,

      // -----------------------------------------------------------------------
      // ERC-1404 测试 Token
      // -----------------------------------------------------------------------
      // 用于部署 ERC1404Adapter 并验证 detectTransferRestriction。
      // 必须实现目标 ERC-1404 selector，且 codeHash 会进入 Adapter 基线。
      // 若本轮不测试 ERC-1404，当前 Schema 仍要求填写一个本地 fixture 地址。
      "erc1404Token": "0x0000000000000000000000000000000000002003",

      // -----------------------------------------------------------------------
      // USDY 候选 Token
      // -----------------------------------------------------------------------
      // 应填写 USDY ERC-1967 proxy 地址，而不是 implementation 地址。
      // 本地可使用 fixture；Ethereum 主网必须来自批准固定区块证据。
      // 未完成 INT-001/002/003 时只能保持 candidate，不能标记生产批准。
      "usdyToken": "0x0000000000000000000000000000000000002004"
    },

    "providers": {
      // -----------------------------------------------------------------------
      // USDY Blocklist Provider
      // -----------------------------------------------------------------------
      // 应等于 usdyToken.blocklist() 在固定区块返回的地址。
      // 该地址需实现 isBlocked(address) -> bool。
      "usdyBlocklist": "0x0000000000000000000000000000000000002101",

      // -----------------------------------------------------------------------
      // USDY Allowlist Provider
      // -----------------------------------------------------------------------
      // 应等于 usdyToken.allowlist() 返回的地址。
      // 该地址需实现 isAllowed(address) -> bool。
      "usdyAllowlist": "0x0000000000000000000000000000000000002102",

      // -----------------------------------------------------------------------
      // USDY Sanctions Provider
      // -----------------------------------------------------------------------
      // 应等于 usdyToken.sanctionsList() 返回的地址。
      // 该地址需实现 isSanctioned(address) -> bool。
      "usdySanctionsList": "0x0000000000000000000000000000000000002103",

      // -----------------------------------------------------------------------
      // Provider staticcall Gas 上限
      // -----------------------------------------------------------------------
      // 类型：1 到 Number.MAX_SAFE_INTEGER 的正整数。
      // 单位：EVM Gas。
      // 太低会把正常 Provider 判为 UNKNOWN；太高会扩大外部调用 Gas 风险。
      // 100000 仅为本地测试值；生产值必须由 T373/T374 Gas 基准冻结。
      "providerCallGas": 100000
    },

    "participants": {
      // -----------------------------------------------------------------------
      // 报价做市商钱包
      // -----------------------------------------------------------------------
      // 在离线示例中会登记为 ParticipantType.MAKER。
      // 它签署 FirmQuote，并根据 BUY/SELL 成为最终买方或卖方。
      // 必须与 requester 不同，且不是零地址。
      "maker": "0x0000000000000000000000000000000000002201",

      // -----------------------------------------------------------------------
      // 询价方钱包
      // -----------------------------------------------------------------------
      // 在离线示例中会登记为 ParticipantType.INVESTOR。
      // 它签署 TradeIntent，签名地址必须等于实际结算钱包。
      // 必须与 maker 不同，且不是零地址。
      "requester": "0x0000000000000000000000000000000000002202"
    },

    // -------------------------------------------------------------------------
    // Fee Collector
    // -------------------------------------------------------------------------
    // 接收 collectorCredit = buyerFee + sellerFee。
    // 必须非零；不得填写客户 PII，只填写链上地址。
    // 本地可使用测试账户；生产必须是批准的财务/费用归集地址。
    "collector": "0x0000000000000000000000000000000000002203",

    // -------------------------------------------------------------------------
    // Economic Asset canonical ID Hash
    // -------------------------------------------------------------------------
    // 格式：非零 bytes32，即 0x + 64 个十六进制字符。
    // 原像通常是内部经济资产标识经严格 UTF-8、NFC、长度/Cc 校验后，
    // 使用 HTP_ECONOMIC_ASSET_ID 域和 schemaVersion 计算得到。
    // 不能直接填写证券名称、Ticker、ISIN 或其普通 keccak。
    // 应使用 packages/id-tools 生成并保存可审计原像映射。
    "economicAssetIdHash": "0x1111111111111111111111111111111111111111111111111111111111111111",

    "schedule": {
      // -----------------------------------------------------------------------
      // Quote 开始时间
      // -----------------------------------------------------------------------
      // Unix 秒时间戳，正整数。
      // 必须满足 quoteValidFrom <= quoteValidUntil <= settlementValidUntil。
      // 完整激活时应填写当前链时间或未来时间；示例 1/2/3 仅用于结构演示，
      // 在当前时间较大的链上不能作为真实业务有效期。
      "quoteValidFrom": 1,

      // Quote 最后允许签署/使用的 Unix 秒时间戳。
      // 必须 >= quoteValidFrom。
      "quoteValidUntil": 2,

      // 该 Fee Epoch/配置允许完成结算的最晚 Unix 秒时间戳。
      // 必须 >= quoteValidUntil。
      "settlementValidUntil": 3
    },

    // FeeConfig 按参与者类型定价，不按本次交易的 buyer/seller 方向配置。
    "fee": {
      "investorRateBps": 25,
      "investorHasCap": true,
      "investorCapAmount": 50000,
      "makerRateBps": 15,
      "makerHasCap": false,
      "makerCapAmount": 0
    },

    // 首个 MarketRuleConfig；有效期复用上面的 schedule。
    "marketRule": {
      "minCashPrincipal": 1,
      "minExecutableQuantity": 1,
      "quantityStep": 1,
      "priceTick": 1,
      "priceDecimals": 6,
      "quantityDecimals": 18
    },

    // -------------------------------------------------------------------------
    // Evidence Hash
    // -------------------------------------------------------------------------
    // 格式：非零 bytes32。
    // 用于事件和治理操作中引用审批单、测试报告或配置证据。
    // 推荐对版本化、不可变、已脱敏的证据文件计算 Hash。
    // 禁止在链上或配置中放客户身份、私钥、签名、RPC 凭证或原始文档内容。
    "evidenceHash": "0x2222222222222222222222222222222222222222222222222222222222222222"
  },

  "externalPolicy": {
    // =========================================================================
    // 外部链策略审批状态
    // =========================================================================

    // 可填写：
    // - LOCAL_ONLY：LOCAL_TEST 专用。
    // - UNAPPROVED：CHAIN_PLACEHOLDER 专用。
    // 当前 Schema 不支持 PRODUCTION_APPROVED；生产批准由后续正式发布包管理。
    "approvalStatus": "LOCAL_ONLY",

    // -------------------------------------------------------------------------
    // RPC 地址
    // -------------------------------------------------------------------------
    // 当前 Schema 强制为 null。
    // RPC URL、用户名、Token 等通过命令行、CI secret 或运行环境提供，禁止入库。
    "rpcUrls": null,

    // -------------------------------------------------------------------------
    // Finality 确认数
    // -------------------------------------------------------------------------
    // 当前 Schema 强制为 null。
    // Ethereum/BSC/HSK 的最终值必须经固定客户端/RPC/重组证据批准。
    "finalityConfirmations": null,

    // -------------------------------------------------------------------------
    // Gas 策略
    // -------------------------------------------------------------------------
    // 当前 Schema 强制为 null。
    // 后续批准包可独立描述 gasLimit、maxFeePerGas、maxPriorityFeePerGas 等，
    // 但本配置不能提前填写示例值冒充批准。
    "gasPolicy": null,

    // -------------------------------------------------------------------------
    // 交易封装类型
    // -------------------------------------------------------------------------
    // 当前 Schema 强制为 null。
    // 未来批准值可能是 LEGACY 或 TYPE2，但必须按链独立批准，不在本地配置固化。
    "transactionType": null
  }
}
