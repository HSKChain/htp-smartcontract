{
  "name": "htp-smartcontract-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build-time schema, vector, and reproducibility tooling for HTP DvP contracts.",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "22.23.4",
    "npm": "11.11.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "contracts:fmt": "forge fmt --root contracts --check",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:unit": "forge test --root contracts --match-path 'test/unit/**/*.t.sol'",
    "contracts:integration": "forge test --root contracts --match-path 'test/integration/**/*.t.sol'",
    "contracts:fuzz": "forge test --root contracts --match-path 'test/fuzz/**/*.t.sol'",
    "contracts:invariant": "forge test --root contracts --match-path 'test/invariant/**/*.t.sol'",
    "contracts:slowmist": "forge test --root contracts --match-path 'test/slowmist_audit/**/*.t.sol'",
    "contracts:e2e": "cd contracts && forge script script/e2e/UsdyOperatorPipeline.s.sol:UsdyOperatorPipeline -vvv",
    "contracts:size": "forge build --root contracts --sizes",
    "contracts:coverage": "node scripts/phase19-coverage.mjs",
    "contracts:coverage:self-test": "node scripts/phase19-coverage.mjs --self-test",
    "constants:generate": "tsx packages/schema-tools/src/verify/constants.ts --write",
    "constants:check": "tsx packages/schema-tools/src/verify/constants.ts",
    "ids:test": "tsx --test packages/id-tools/test/*.test.ts",
    "vectors:generate": "tsx packages/schema-tools/src/vectors.ts --write",
    "vectors:check": "tsx packages/schema-tools/src/vectors.ts",
    "phase3:test": "npm run ids:test && npm run vectors:check",
    "calculator:test": "tsx --test packages/calc-reference/test/*.test.ts",
    "calculator:generate": "tsx packages/calc-reference/src/generate.ts --write",
    "calculator:check": "tsx packages/calc-reference/src/generate.ts",
    "fee:generate": "tsx packages/calc-reference/src/generate-fees.ts --write",
    "fee:check": "tsx packages/calc-reference/src/generate-fees.ts",
    "calculator:bytecode": "node scripts/security/check-calculator-bytecode.mjs",
    "adapter:bytecode": "node scripts/security/check-adapter-bytecode.mjs",
    "codehash:sync": "node scripts/security/sync-validator-codehashes.mjs",
    "codehash:check": "node scripts/security/sync-validator-codehashes.mjs --check",
    "security:slither": "node scripts/security/run-slither.mjs",
    "security:slither:self-test": "node scripts/security/run-slither.mjs --self-test",
    "security:repository-secrets": "node scripts/security/scan-repository-secrets.mjs",
    "security:repository-secrets:self-test": "node scripts/security/scan-repository-secrets.mjs --self-test",
    "registry:storage": "forge clean --root contracts && forge build --root contracts --skip test --skip script && node scripts/security/check-registry-storage.mjs",
    "registry:storage:self-test": "node scripts/security/check-registry-storage.mjs --self-test",
    "phase4:test": "npm run calculator:test && npm run calculator:check && npm run fee:check",
    "schema:manifests:generate": "tsx packages/schema-tools/src/cli.ts generate",
    "schema:manifests:check": "tsx packages/schema-tools/src/cli.ts check",
    "phase17:vectors:generate": "tsx packages/schema-tools/src/phase17.ts --write",
    "phase17:vectors:check": "tsx packages/schema-tools/src/phase17.ts",
    "schema:generate": "tsx packages/schema-tools/src/cli.ts generate",
    "schema:check": "tsx packages/schema-tools/src/cli.ts check",
    "schema:test": "forge clean --root contracts && forge build --root contracts --skip test && tsx --test packages/schema-tools/test/*.test.ts",
    "schema:python": "PYTHONDONTWRITEBYTECODE=1 node scripts/run-python-consumer.mjs",
    "schema:secrets": "node scripts/security/scan-schema-secrets.mjs",
    "schema:secrets:self-test": "node scripts/security/scan-schema-secrets.mjs --self-test",
    "phase17:test": "npm run typecheck && npm run phase3:test && npm run phase4:test && npm run schema:test && npm run schema:check && npm run schema:python && npm run schema:secrets:self-test && npm run schema:secrets",
    "deploy:config:test": "node --test scripts/deploy/*.test.mjs",
    "deploy:config:check": "node scripts/deploy/validate-config.mjs",
    "deploy:config:secrets": "node scripts/deploy/scan-config-secrets.mjs",
    "phase18:config": "npm run deploy:config:test && npm run deploy:config:check && npm run deploy:config:secrets",
    "phase18:tooling:test": "node --test scripts/test/*.test.mjs",
    "phase18:fork:usdy": "node scripts/fork/verify-usdy-fixed-block.mjs",
    "phase18:fork:ondo-gm": "node scripts/fork/verify-ondo-gm-fixed-block.mjs",
    "phase18:test": "npm run phase18:config && npm run phase18:tooling:test && npm run phase18:fork:usdy && npm run phase18:fork:ondo-gm",
    "ops:test": "node --test scripts/ops/*.test.mjs",
    "ops:platform:self-test": "node scripts/ops/deploy-platform.mjs --self-test",
    "ops:adapter:self-test": "node scripts/ops/deploy-adapter.mjs --self-test",
    "ops:asset:self-test": "node scripts/ops/list-asset.mjs --self-test",
    "reproducible:check": "node scripts/reproducible-build.mjs",
    "reproducible:self-test": "node scripts/reproducible-build.mjs --self-test"
  },
  "devDependencies": {
    "@openzeppelin/upgrades-core": "1.46.0",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "viem": "2.55.11"
  }
}
