{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.mjs",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "contracts/lib",
    "contracts/out",
    "contracts/cache",
    "schema"
  ]
}
